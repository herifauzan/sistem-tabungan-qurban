# ============================================================
# SISTEM TABUNGAN QURBAN — Masjid Al-Bina
# Environment Variables Configuration
# ============================================================
# Salin file ini menjadi .env.local dan isi nilainya.

# --- NextAuth.js ---
# Buat secret acak: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# --- Google Service Account ---
# Email service account dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Private key dari file JSON service account (termasuk header/footer)
# Ganti newline dengan \n saat memasukkan ke env var
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----"

# --- Google Sheets ---
# ID spreadsheet (dari URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# --- Google Drive ---
# ID folder Drive tempat menyimpan bukti transfer
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here
